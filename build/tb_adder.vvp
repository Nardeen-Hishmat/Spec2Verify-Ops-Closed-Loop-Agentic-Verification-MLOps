#! /usr/bin/vvp
:ivl_version "10.3 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "vhdl_sys";
:vpi_module "v2005_math";
:vpi_module "va_math";
:vpi_module "v2009";
S_0x55555584a1a0 .scope module, "tb_adder" "tb_adder" 2 3;
 .timescale -9 -12;
v0x5555558765d0_0 .var/s "A", 3 0;
v0x5555558766b0_0 .var/s "B", 3 0;
v0x555555876750_0 .net/s "C", 4 0, v0x555555847960_0;  1 drivers
v0x5555558767f0_0 .var/i "checks", 31 0;
v0x555555876890_0 .var "clk", 0 0;
v0x555555876980_0 .var/s "expected", 4 0;
v0x555555876a40_0 .var/i "failures", 31 0;
v0x555555876b20_0 .var/s "held_value", 4 0;
v0x555555876c00_0 .var/i "i", 31 0;
v0x555555876ce0_0 .var/i "j", 31 0;
v0x555555876dc0_0 .var "reset", 0 0;
E_0x555555854ac0 .event posedge, v0x555555847f00_0;
E_0x555555854ed0 .event negedge, v0x555555847f00_0;
S_0x555555855a90 .scope task, "check_output" "check_output" 2 32, 2 32 0, S_0x55555584a1a0;
 .timescale -9 -12;
v0x555555845890_0 .var/s "expected_value", 4 0;
TD_tb_adder.check_output ;
    %load/vec4 v0x5555558767f0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5555558767f0_0, 0, 32;
    %load/vec4 v0x555555876750_0;
    %load/vec4 v0x555555845890_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x555555876a40_0;
    %addi 1, 0, 32;
    %store/vec4 v0x555555876a40_0, 0, 32;
    %vpi_call/w 2 40 "$display", "FAIL: time=%0t A=%0d B=%0d reset=%b expected=%0d actual=%0d", $time, v0x5555558765d0_0, v0x5555558766b0_0, v0x555555876dc0_0, v0x555555845890_0, v0x555555876750_0 {0 0 0};
T_0.0 ;
    %end;
S_0x555555876130 .scope module, "dut" "adder" 2 20, 3 1 0, S_0x55555584a1a0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk"
    .port_info 1 /INPUT 1 "reset"
    .port_info 2 /INPUT 4 "A"
    .port_info 3 /INPUT 4 "B"
    .port_info 4 /OUTPUT 5 "C"
v0x555555845e10_0 .net/s "A", 3 0, v0x5555558765d0_0;  1 drivers
v0x555555846460_0 .net/s "B", 3 0, v0x5555558766b0_0;  1 drivers
v0x555555847960_0 .var/s "C", 4 0;
v0x555555847f00_0 .net "clk", 0 0, v0x555555876890_0;  1 drivers
v0x555555876420_0 .net "reset", 0 0, v0x555555876dc0_0;  1 drivers
E_0x55555582f870 .event posedge, v0x555555876420_0, v0x555555847f00_0;
    .scope S_0x555555876130;
T_1 ;
    %wait E_0x55555582f870;
    %load/vec4 v0x555555876420_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 5;
    %assign/vec4 v0x555555847960_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x555555845e10_0;
    %pad/s 5;
    %load/vec4 v0x555555846460_0;
    %pad/s 5;
    %add;
    %assign/vec4 v0x555555847960_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x55555584a1a0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x555555876890_0;
    %inv;
    %store/vec4 v0x555555876890_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x55555584a1a0;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555555876890_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555555876dc0_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5555558765d0_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5555558766b0_0, 0, 4;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5555558767f0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x555555876a40_0, 0, 32;
    %delay 1000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555555876dc0_0, 0, 1;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %wait E_0x555555854ed0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555555876dc0_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x555555876c00_0, 0, 32;
T_3.0 ;
    %load/vec4 v0x555555876c00_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_3.1, 5;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x555555876ce0_0, 0, 32;
T_3.2 ;
    %load/vec4 v0x555555876ce0_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_3.3, 5;
    %load/vec4 v0x555555876750_0;
    %store/vec4 v0x555555876b20_0, 0, 5;
    %wait E_0x555555854ed0;
    %load/vec4 v0x555555876c00_0;
    %pad/s 4;
    %store/vec4 v0x5555558765d0_0, 0, 4;
    %load/vec4 v0x555555876ce0_0;
    %pad/s 4;
    %store/vec4 v0x5555558766b0_0, 0, 4;
    %delay 1000, 0;
    %load/vec4 v0x555555876b20_0;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %wait E_0x555555854ac0;
    %delay 1000, 0;
    %load/vec4 v0x5555558765d0_0;
    %parti/s 1, 3, 3;
    %load/vec4 v0x5555558765d0_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v0x5555558766b0_0;
    %parti/s 1, 3, 3;
    %load/vec4 v0x5555558766b0_0;
    %concat/vec4; draw_concat_vec4
    %add;
    %store/vec4 v0x555555876980_0, 0, 5;
    %load/vec4 v0x555555876980_0;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %load/vec4 v0x555555876ce0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x555555876ce0_0, 0, 32;
    %jmp T_3.2;
T_3.3 ;
    %load/vec4 v0x555555876c00_0;
    %addi 1, 0, 32;
    %store/vec4 v0x555555876c00_0, 0, 32;
    %jmp T_3.0;
T_3.1 ;
    %wait E_0x555555854ed0;
    %delay 1000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555555876dc0_0, 0, 1;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %wait E_0x555555854ac0;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %wait E_0x555555854ed0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555555876dc0_0, 0, 1;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5555558765d0_0, 0, 4;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5555558766b0_0, 0, 4;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %wait E_0x555555854ac0;
    %delay 1000, 0;
    %pushi/vec4 10, 0, 5;
    %store/vec4 v0x555555845890_0, 0, 5;
    %fork TD_tb_adder.check_output, S_0x555555855a90;
    %join;
    %load/vec4 v0x555555876a40_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.4, 4;
    %vpi_call/w 2 124 "$display", "CHECKS=%0d FAILURES=0", v0x5555558767f0_0 {0 0 0};
    %vpi_call/w 2 125 "$display", "REGRESSION_STATUS=PASS" {0 0 0};
    %vpi_call/w 2 126 "$finish" {0 0 0};
    %jmp T_3.5;
T_3.4 ;
    %vpi_call/w 2 128 "$fatal", 32'sb00000000000000000000000000000001, "REGRESSION_STATUS=FAIL checks=%0d failures=%0d", v0x5555558767f0_0, v0x555555876a40_0 {0 0 0};
T_3.5 ;
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/tb_adder.v";
    "rtl/adder.v";
